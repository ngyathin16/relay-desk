# Copy to .env. No credentials are needed for the extractive baseline.
PORT=3210
DATA_DIR=./data

# Optional local Ollama (a real model, no remote API key):
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=qwen3.5:9b
# PROVIDER_TIMEOUT_MS=120000

# Optional hosted OpenAI-compatible API; model choice is explicit.
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=your-structured-output-model
# MODEL_API_KEY=your-key
# OPENAI_MODEL and OPENAI_API_KEY are also accepted aliases.
# PROVIDER_TIMEOUT_MS=20000
